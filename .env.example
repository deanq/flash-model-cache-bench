# Copy to .env (make setup does this). .env is gitignored.

# Runpod API key. Optional if you have run `uv run flash login` (the key in
# ~/.runpod/config.toml is used as a fallback).
RUNPOD_API_KEY=

# Only needed for gated/private models.
HF_TOKEN=

# --- Benchmark knobs (all optional; defaults shown) ---
# MODEL=Qwen/Qwen2.5-3B-Instruct
# GPU=ADA_24                 # runpod_flash GpuGroup/GpuType name(s), comma-separated
# DATACENTER=EU-RO-1         # must support network volumes
# VOLUME_GB=50               # needs ~2.2x the model size (volume copy + VolumeCache mirror)
# STRATEGIES=nocache,volume,volumecache,modelstore
# COLD_TRIALS=3              # forced-cold requests per strategy
# WARM_PER_COLD=2            # warm requests after each cold one
# MAX_NEW_TOKENS=128
# PARALLEL=1                 # run strategies concurrently within a round (0 = one at a time)
# EVICT_PAGE_CACHE=1         # posix_fadvise(DONTNEED) volume/Model Store files before reading
# KEEP=0                     # 1 = skip teardown (debugging; remember `make clean`)
